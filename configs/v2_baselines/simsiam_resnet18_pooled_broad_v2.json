{
  "run": {
    "name": "simsiam_resnet18_pooled_broad_natural_seed42_v2",
    "output_root": "${PNP_RUNS_ROOT}/hpc/v2/baselines/simsiam"
  },
  "model": {
    "method": "simsiam",
    "backbone": "resnet18",
    "initialization": "scratch",
    "projection_layers": 3,
    "projection_hidden_dimension": 2048,
    "projection_dimension": 2048,
    "prediction_layers": 2,
    "prediction_hidden_dimension": 512,
    "prediction_dimension": 2048,
    "final_projection_batch_norm_affine": false,
    "explicit_stop_gradient": true
  },
  "data": {
    "benchmark_id": "pooled_broad_p80_10_10_v2",
    "sampling": "natural_frequency",
    "train_manifest": "${PNP_DATA_ROOT}/processed/plagnetplus/ssl_unified_v2/benchmarks/pooled_broad_p80_10_10_v2/manifests/crystals_train.csv",
    "validation_manifest": "${PNP_DATA_ROOT}/processed/plagnetplus/ssl_unified_v2/benchmarks/pooled_broad_p80_10_10_v2/manifests/crystals_validation.csv",
    "test_manifest": "${PNP_DATA_ROOT}/processed/plagnetplus/ssl_unified_v2/benchmarks/pooled_broad_p80_10_10_v2/manifests/crystals_test.csv",
    "image_root_map": "${PNP_DATA_ROOT}/processed/plagnetplus/ssl_unified_v2/metadata/image_root_map.json",
    "transform_config": "${PNP_DATA_ROOT}/processed/plagnetplus/ssl_unified_v2/benchmarks/pooled_broad_p80_10_10_v2/metadata/normalization_v2/ssl_transform_config_v2.json",
    "expected_train_rows": 91357,
    "expected_validation_rows": 14919,
    "expected_test_rows": 16988,
    "limit_train_items": null,
    "limit_validation_items": null,
    "verify_files": "sample",
    "verify_sample_size": 2048
  },
  "optimization": {
    "epochs": 100,
    "batch_size": 256,
    "evaluation_batch_size": 256,
    "optimizer": "sgd",
    "learning_rate": 0.05,
    "minimum_learning_rate": 0.0,
    "predictor_learning_rate_mode": "fixed",
    "predictor_learning_rate": 0.05,
    "momentum": 0.9,
    "weight_decay": 0.0001,
    "warmup_epochs": 10,
    "gradient_clip_norm": 5.0
  },
  "runtime": {
    "num_workers": 8,
    "checkpoint_every": 10,
    "validation_every": 1,
    "seed": 42,
    "use_amp": false,
    "export_train_embeddings": true,
    "export_validation_embeddings": true
  },
  "monitoring": {
    "track_projection_standard_deviation": true,
    "track_collapse_level": true,
    "track_backbone_feature_norm": true,
    "track_projection_norm": true,
    "require_finite_loss": true,
    "require_finite_gradients": true
  }
}
