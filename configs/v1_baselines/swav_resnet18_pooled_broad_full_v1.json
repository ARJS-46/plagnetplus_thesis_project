{
  "run": {
    "name": "swav_resnet18_pooled_broad_natural_seed42_v1",
    "output_root": "${PNP_RUNS_ROOT}/hpc/swav"
  },
  "model": {
    "method": "swav",
    "backbone": "resnet18",
    "initialization": "scratch",
    "projection_hidden_dimension": 2048,
    "projection_dimension": 128,
    "prototype_count": 500,
    "temperature": 0.1,
    "sinkhorn_epsilon": 0.05,
    "sinkhorn_iterations": 3,
    "global_crops": 2,
    "local_crops": 0,
    "queue_length": 0
  },
  "data": {
    "benchmark_id": "pooled_broad_p80_10_10_v1",
    "sampling": "natural_frequency",
    "train_manifest": "${PNP_DATA_ROOT}/processed/plagnetplus/ssl_unified_v1/benchmarks/pooled_broad_p80_10_10_v1/manifests/crystals_train.csv",
    "validation_manifest": "${PNP_DATA_ROOT}/processed/plagnetplus/ssl_unified_v1/benchmarks/pooled_broad_p80_10_10_v1/manifests/crystals_validation.csv",
    "test_manifest": "${PNP_DATA_ROOT}/processed/plagnetplus/ssl_unified_v1/benchmarks/pooled_broad_p80_10_10_v1/manifests/crystals_test.csv",
    "image_root_map": "${PNP_DATA_ROOT}/processed/plagnetplus/ssl_unified_v1/metadata/image_root_map.json",
    "transform_config": "${PNP_DATA_ROOT}/processed/plagnetplus/ssl_unified_v1/benchmarks/pooled_broad_p80_10_10_v1/metadata/normalization_v1/ssl_transform_config_v1.json",
    "expected_manifest_fingerprint_sha256": "a2814f1c33b5adc45e9d4c8c90c7af7577e237ca74d112473a274dbd949ab582",
    "expected_train_rows": 101682,
    "expected_validation_rows": 14919,
    "expected_test_rows": 16988,
    "limit_train_items": null,
    "limit_validation_items": null,
    "verify_files": "sample",
    "verify_sample_size": 2048
  },
  "optimization": {
    "epochs": 100,
    "batch_size": 256,
    "evaluation_batch_size": 256,
    "optimizer": "sgd",
    "learning_rate": 0.3,
    "minimum_learning_rate": 0.0,
    "momentum": 0.9,
    "weight_decay": 0.000001,
    "warmup_epochs": 10,
    "gradient_clip_norm": 5.0,
    "prototype_freeze_epochs": 1
  },
  "runtime": {
    "num_workers": 8,
    "checkpoint_every": 10,
    "validation_every": 1,
    "seed": 42,
    "use_amp": true,
    "export_train_embeddings": true,
    "export_validation_embeddings": true
  },
  "monitoring": {
    "track_assignment_entropy": true,
    "track_prototype_occupancy": true,
    "track_assignment_agreement": true,
    "track_backbone_feature_norm": true,
    "track_projection_norm": true,
    "track_prototype_weight_norm": true,
    "require_finite_loss": true,
    "require_finite_gradients": true
  }
}
