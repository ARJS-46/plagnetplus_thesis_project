#!/bin/bash
#PBS -N pnp_ssl_grid
#PBS -J 1-24%4
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1:gpu_type=L40S
#PBS -l walltime=06:00:00
#PBS -j oe

set -euo pipefail

module load miniforge/3
eval "$(~/miniforge3/bin/conda shell.bash hook)"
conda activate plagnet-simclr

: "${TMPDIR:?PBS TMPDIR is not set}"
: "${PBS_JOBID:?PBS_JOBID is not set}"
: "${PBS_ARRAY_INDEX:?PBS_ARRAY_INDEX is not set}"

HPC_ROOT="/rds/general/user/ars223/home/IRP26"

INPUT_ROOT="${HPC_ROOT}/inputs/simsiam_swav_grid_screen_v1"
DATA_INPUT_ROOT="${HPC_ROOT}/inputs/simclr_resnet18_pooled_v1"

CODE_BUNDLE="${INPUT_ROOT}/plagnetplus_simsiam_swav_grid_screen_v1.tar.gz"

AEGINA_ARCHIVE="${DATA_INPUT_ROOT}/data_ssl_aegina_compat_v1.tar"
NON_AEGINA_ARCHIVE="${DATA_INPUT_ROOT}/data_ssl_non_aegina_v1.tar"
UNIFIED_ARCHIVE="${DATA_INPUT_ROOT}/data_ssl_unified_v1.tar"

STAGE_ROOT="${TMPDIR}/IRP26"
WORK_ROOT="${STAGE_ROOT}/plagnetplus-dev"
DATA_ROOT="${STAGE_ROOT}/data"

PYTHON="${HOME}/miniforge3/envs/plagnet-simclr/bin/python"

ARRAY_INDEX="${PBS_ARRAY_INDEX}"

if ! [[ "${ARRAY_INDEX}" =~ ^[0-9]+$ ]]; then
  echo "FAIL: PBS_ARRAY_INDEX is not an integer."
  exit 1
fi

if (( ARRAY_INDEX < 1 || ARRAY_INDEX > 24 )); then
  echo "FAIL: array index must lie in 1..24."
  exit 1
fi

export PNP_DATA_ROOT="${DATA_ROOT}"
export PNP_RUNS_ROOT="${HPC_ROOT}/runs"
export PNP_GRID_STATUS_ROOT="${HPC_ROOT}/runs/hpc/grid_search/simsiam_swav_screen_v1/status"

export PYTHONPATH="${WORK_ROOT}/src"
export PYTHONUNBUFFERED=1

export OMP_NUM_THREADS=8
export MKL_NUM_THREADS=8
export OPENBLAS_NUM_THREADS=8

echo
echo "========== SSL GRID ARRAY TASK =========="
echo "PBS job ID: ${PBS_JOBID}"
echo "PBS array index: ${ARRAY_INDEX}"
echo "Host: $(hostname)"
echo "TMPDIR: ${TMPDIR}"
echo "Started UTC: $(date -u --iso-8601=seconds)"

for REQUIRED in \
  "${PYTHON}" \
  "${CODE_BUNDLE}" \
  "${AEGINA_ARCHIVE}" \
  "${NON_AEGINA_ARCHIVE}" \
  "${UNIFIED_ARCHIVE}"
do
  test -f "${REQUIRED}" || {
    echo "FAIL: missing ${REQUIRED}"
    exit 1
  }
done

echo
echo "----- Verify grid deployment integrity -----"

cd "${INPUT_ROOT}"
sha256sum -c SHA256SUMS

echo
echo "----- Prepare node-local stage -----"

rm -rf "${STAGE_ROOT}"

mkdir -p \
  "${WORK_ROOT}" \
  "${DATA_ROOT}" \
  "${HPC_ROOT}/runs/hpc/grid_search/simsiam_screen_v1" \
  "${HPC_ROOT}/runs/hpc/grid_search/swav_screen_v1" \
  "${PNP_GRID_STATUS_ROOT}"

echo
echo "----- Extract combined code bundle -----"

time tar -xzf \
  "${CODE_BUNDLE}" \
  -C "${WORK_ROOT}"

echo
echo "----- Extract frozen image and manifest archives -----"

time tar -xf \
  "${AEGINA_ARCHIVE}" \
  -C "${DATA_ROOT}"

time tar -xf \
  "${NON_AEGINA_ARCHIVE}" \
  -C "${DATA_ROOT}"

time tar -xf \
  "${UNIFIED_ARCHIVE}" \
  -C "${DATA_ROOT}"

RUNNER="${WORK_ROOT}/tools/training/run_simsiam_swav_grid_trial.py"
MANIFEST="${WORK_ROOT}/configs/grid_search/simsiam_swav_screen_v1/grid_manifest.csv"

for REQUIRED in \
  "${RUNNER}" \
  "${MANIFEST}" \
  "${WORK_ROOT}/tools/training/train_simsiam.py" \
  "${WORK_ROOT}/tools/training/train_swav.py"
do
  test -f "${REQUIRED}" || {
    echo "FAIL: staged file missing: ${REQUIRED}"
    exit 1
  }
done

echo
echo "----- Compile staged training code -----"

"${PYTHON}" -m py_compile \
  "${RUNNER}" \
  "${WORK_ROOT}/tools/training/train_simsiam.py" \
  "${WORK_ROOT}/tools/training/train_swav.py"

echo "STAGED PYTHON SYNTAX: PASS"

echo
echo "----- GPU and package preflight -----"

nvidia-smi

"${PYTHON}" - <<'PY'
from __future__ import annotations

import os

import torch

from plagnetplus.models import (
    SimSiamModel,
    SwAVModel,
)

from plagnetplus.training.simsiam_config import (
    load_simsiam_training_config,
)

from plagnetplus.training.swav_config import (
    load_swav_training_config,
)


print(f"torch={torch.__version__}")
print(f"cuda_available={torch.cuda.is_available()}")
print(f"cuda_device_count={torch.cuda.device_count()}")
print(f"PNP_DATA_ROOT={os.environ['PNP_DATA_ROOT']}")
print(f"PNP_RUNS_ROOT={os.environ['PNP_RUNS_ROOT']}")

if not torch.cuda.is_available():
    raise SystemExit(
        "FAIL: CUDA is unavailable."
    )

print(
    "GPU:",
    torch.cuda.get_device_name(0),
)

print(
    "SIMSIAM AND SWAV IMPORTS: PASS"
)
PY

echo
echo "----- Execute manifest-selected screening trial -----"

cd "${WORK_ROOT}"

"${PYTHON}" "${RUNNER}" \
  --project-root "${WORK_ROOT}" \
  --manifest "${MANIFEST}" \
  --array-index "${ARRAY_INDEX}"

echo
echo "Finished UTC: $(date -u --iso-8601=seconds)"
echo "========== SSL GRID ARRAY TASK COMPLETE =========="
