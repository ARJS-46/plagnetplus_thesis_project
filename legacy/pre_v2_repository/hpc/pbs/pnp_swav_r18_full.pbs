#!/bin/bash
#PBS -N pnp_swav_r18_full
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1:gpu_type=L40S
#PBS -l walltime=24:00:00
#PBS -j oe

set -euo pipefail

module load miniforge/3
eval "$(~/miniforge3/bin/conda shell.bash hook)"
conda activate plagnet-simclr

: "${TMPDIR:?PBS TMPDIR is not set}"
: "${PBS_JOBID:?PBS_JOBID is not set}"

HPC_ROOT="/rds/general/user/ars223/home/IRP26"

INPUT_ROOT="${HPC_ROOT}/inputs/swav_resnet18_full_v1"
DATA_INPUT_ROOT="${HPC_ROOT}/inputs/simclr_resnet18_pooled_v1"

CODE_BUNDLE="${INPUT_ROOT}/plagnetplus_swav_full_v1.tar.gz"

AEGINA_ARCHIVE="${DATA_INPUT_ROOT}/data_ssl_aegina_compat_v1.tar"
NON_AEGINA_ARCHIVE="${DATA_INPUT_ROOT}/data_ssl_non_aegina_v1.tar"
UNIFIED_ARCHIVE="${DATA_INPUT_ROOT}/data_ssl_unified_v1.tar"

STAGE_ROOT="${TMPDIR}/IRP26"
WORK_ROOT="${STAGE_ROOT}/plagnetplus-dev"
DATA_ROOT="${STAGE_ROOT}/data"

RUN_ID="${PBS_JOBID%%.*}"
RUN_NAME="swav_resnet18_pooled_broad_natural_seed42_full_${RUN_ID}"
RUN_ROOT="${HPC_ROOT}/runs/hpc/swav/${RUN_NAME}"

export PNP_DATA_ROOT="${DATA_ROOT}"
export PNP_RUNS_ROOT="${HPC_ROOT}/runs"
export PYTHONPATH="${WORK_ROOT}/src"
export PYTHONUNBUFFERED=1

export OMP_NUM_THREADS=8
export MKL_NUM_THREADS=8
export OPENBLAS_NUM_THREADS=8

echo "========== SWAV FULL PRODUCTION RUN =========="
echo "PBS job: ${PBS_JOBID}"
echo "Host: $(hostname)"
echo "TMPDIR: ${TMPDIR}"
echo "Run name: ${RUN_NAME}"
echo "Started UTC: $(date -u --iso-8601=seconds)"

for REQUIRED in \
  "${CODE_BUNDLE}" \
  "${AEGINA_ARCHIVE}" \
  "${NON_AEGINA_ARCHIVE}" \
  "${UNIFIED_ARCHIVE}"
do
  test -f "${REQUIRED}" || {
    echo "FAIL: missing ${REQUIRED}"
    exit 1
  }
done

cd "${INPUT_ROOT}"
sha256sum -c SHA256SUMS

rm -rf "${STAGE_ROOT}"

mkdir -p \
  "${WORK_ROOT}" \
  "${DATA_ROOT}" \
  "${HPC_ROOT}/runs/hpc/swav"

time tar -xzf "${CODE_BUNDLE}" -C "${WORK_ROOT}"
time tar -xf "${AEGINA_ARCHIVE}" -C "${DATA_ROOT}"
time tar -xf "${NON_AEGINA_ARCHIVE}" -C "${DATA_ROOT}"
time tar -xf "${UNIFIED_ARCHIVE}" -C "${DATA_ROOT}"

CONFIG="${WORK_ROOT}/configs/experiments/swav_resnet18_pooled_broad_full_v1.json"
TRAINER="${WORK_ROOT}/tools/training/train_swav.py"

nvidia-smi

python - <<'PY'
import torch

from plagnetplus.models import SwAVModel
from plagnetplus.training import (
    build_swav_optimizer,
)


if not torch.cuda.is_available():
    raise SystemExit("FAIL: CUDA unavailable")

print("GPU:", torch.cuda.get_device_name(0))
print("Complete SwAV imports: PASS")
PY

echo
echo "=== FULL 100-EPOCH TRAINING ==="

python -u "${TRAINER}" \
  --config "${CONFIG}" \
  --run-name "${RUN_NAME}" \
  --device cuda

SUMMARY="${RUN_ROOT}/run_summary.json"

test -f "${SUMMARY}"
test -f "${RUN_ROOT}/training_history.csv"
test -f "${RUN_ROOT}/checkpoints/swav_last.pt"
test -f "${RUN_ROOT}/embeddings/train_backbone_embeddings.npz"
test -f "${RUN_ROOT}/embeddings/validation_backbone_embeddings.npz"
test -f "${RUN_ROOT}/embeddings/prototype_weights.npz"

SUMMARY="${SUMMARY}" \
RUN_ROOT="${RUN_ROOT}" \
python - <<'PY'
from __future__ import annotations

import json
import math
import os
from pathlib import Path


summary = json.loads(
    Path(
        os.environ["SUMMARY"]
    ).read_text(
        encoding="utf-8"
    )
)

checks = {
    "status_pass": (
        summary["status"] == "PASS"
    ),
    "method_swav": (
        summary["method"] == "swav"
    ),
    "hundred_epochs_complete": (
        summary["completed_epochs"] == 100
    ),
    "train_shape_expected": (
        summary["train_embeddings"]["shape"]
        == [101682, 512]
    ),
    "validation_shape_expected": (
        summary[
            "validation_embeddings"
        ]["shape"]
        == [14919, 512]
    ),
    "prototype_shape_expected": (
        summary["prototypes"]["shape"]
        == [500, 128]
    ),
    "prototype_weights_finite": (
        summary["checks"][
            "prototype_weights_finite"
        ]
        is True
    ),
    "history_metrics_finite": (
        summary["checks"][
            "all_history_metrics_finite"
        ]
        is True
    ),
    "manifest_matches": (
        summary["checks"][
            "manifest_fingerprint_matches"
        ]
        is True
    ),
    "test_images_untouched": (
        summary["checks"][
            "test_images_accessed"
        ]
        is False
    ),
    "test_embeddings_absent": (
        summary["checks"][
            "test_embeddings_exported"
        ]
        is False
    ),
    "no_test_embedding_files": (
        not any(
            Path(
                os.environ["RUN_ROOT"]
            ).rglob(
                "*test*embedding*"
            )
        )
    ),
}

for split in (
    "final_train_metrics",
    "final_validation_metrics",
):
    metrics = summary[split]

    for field in (
        "loss",
        "assignment_entropy",
        "normalised_occupancy_entropy",
        "occupied_prototype_fraction",
        "largest_prototype_fraction",
        "assignment_agreement",
        "backbone_feature_norm",
        "projection_norm",
        "prototype_weight_norm",
        "learning_rate",
    ):
        checks[
            f"finite_{split}_{field}"
        ] = math.isfinite(
            float(metrics[field])
        )

for name, passed in checks.items():
    print(f"{name}: {passed}")

if not all(checks.values()):
    raise SystemExit(
        "SWAV FULL-RUN VALIDATION: FAIL"
    )

final_train = summary[
    "final_train_metrics"
]

final_validation = summary[
    "final_validation_metrics"
]

print()
print(
    "GPU hours:",
    summary["gpu_hours"],
)

print(
    "Final train loss:",
    final_train["loss"],
)

print(
    "Final validation loss:",
    final_validation["loss"],
)

print(
    "Final validation occupied fraction:",
    final_validation[
        "occupied_prototype_fraction"
    ],
)

print(
    "Final validation occupancy entropy:",
    final_validation[
        "normalised_occupancy_entropy"
    ],
)

print(
    "Final validation largest fraction:",
    final_validation[
        "largest_prototype_fraction"
    ],
)

print(
    "Final validation agreement:",
    final_validation[
        "assignment_agreement"
    ],
)

print(
    "SWAV FULL-RUN VALIDATION: PASS"
)
PY

echo
echo "Run root: ${RUN_ROOT}"
echo "Finished UTC: $(date -u --iso-8601=seconds)"
echo "SWAV FULL PRODUCTION RUN: PASS"
